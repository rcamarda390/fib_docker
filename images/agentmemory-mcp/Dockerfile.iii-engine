ARG III_VERSION=0.22.0
ARG CURL_INSECURE=0

FROM debian:bookworm-slim AS downloader
ARG III_VERSION
ARG TARGETARCH
ARG CURL_INSECURE
# Upgrade all packages to pull in any available security patches before building
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends ca-certificates curl tar busybox-static \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
RUN case "$TARGETARCH" in \
      amd64) III_ARCH='x86_64-unknown-linux-gnu'; III_SHA256='3479968f31ff6376aa4b7b21b0fb0815ddd5873ed521e3c14e60972cd9941766' ;; \
      arm64) III_ARCH='aarch64-unknown-linux-gnu'; III_SHA256='a628a1f419c1b8afc52d5cafc50d406ffb9f015828ca1196e66615a5eff61be8' ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && if [ "$CURL_INSECURE" = '1' ]; then CURL_FLAGS='-k'; else CURL_FLAGS=''; fi \
 && curl -fsSL $CURL_FLAGS -o "iii-${III_ARCH}.tar.gz" "https://github.com/iii-hq/iii/releases/download/iii/v${III_VERSION}/iii-${III_ARCH}.tar.gz" \
 && echo "$III_SHA256  iii-${III_ARCH}.tar.gz" | sha256sum -c - \
 && tar -xzf "iii-${III_ARCH}.tar.gz" \
 && install -Dm0755 iii /out/usr/local/bin/iii \
 && install -Dm0755 /bin/busybox /out/busybox

FROM gcr.io/distroless/base-debian12:nonroot
ARG III_VERSION
LABEL org.opencontainers.image.title="iii-engine" \
      org.opencontainers.image.description="Pinned iii-engine ${III_VERSION} image for air-gapped agentmemory deployments"
COPY --from=downloader /out/ /
COPY iii-config.yaml /etc/iii/config.yaml
VOLUME ["/data"]
EXPOSE 3112 49134
ENTRYPOINT ["/usr/local/bin/iii", "--config", "/etc/iii/config.yaml", "--no-update-check"]
